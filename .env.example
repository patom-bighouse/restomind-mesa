# Copia este archivo como .env (no se sube a git) y rellena los valores.
# Test:       proyecto Supabase "Restomind Test"
# Producción: proyecto Supabase "restomind" (solo en Vercel, nunca en local)

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Las Edge Functions leen sus secretos de Supabase (supabase secrets set), no de aquí:
#   ANTHROPIC_API_KEY      (importar-carta, traducir-carta)
#   GOOGLE_PLACES_API_KEY  (crm-buscar-restaurantes)
#   SUPABASE_URL / SUPABASE_ANON_KEY los inyecta Supabase automáticamente.
